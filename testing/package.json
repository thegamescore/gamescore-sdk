{
  "name": "@gamescore/sdk-testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --format=esm --platform=neutral --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@gamescore/sdk": "file:.."
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@gamescore/sdk": "^0.1.0"
  }
}
